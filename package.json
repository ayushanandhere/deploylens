{
  "name": "deploylens",
  "version": "0.1.0",
  "private": true,
  "description": "An evidence-based deployment investigation assistant on Cloudflare.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "types": "wrangler types env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.16",
    "@ai-sdk/react": "^3.0.289",
    "@cloudflare/ai-chat": "^0.12.0",
    "agents": "^0.24.0",
    "ai": "^6.0.197",
    "oauth4webapi": "^3.8.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.113.0"
  }
}
